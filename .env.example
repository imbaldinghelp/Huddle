# Copy this file to .env and fill it in. .env is gitignored: never commit it.
#   PowerShell: Copy-Item .env.example .env

# Which settings to use: development or production.
FLASK_CONFIG=development

# Signs the login session cookie. Optional in development, required in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database location. Leave unset locally: Huddle then uses a SQLite file at
# instance/huddle.db. In production this is the Neon PostgreSQL connection string.
# DATABASE_URL=

# ---------- AI assistant ----------
# Models are written the LiteLLM way: <provider>/<model>. The assistant tries
# LLM_MODEL first, then each fallback in order (comma-separated). Left unset,
# Huddle uses the two free-tier defaults shown here.
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite

# One API key per provider you use. A model cannot answer without its key,
# so set at least the key for LLM_MODEL. Keys live only in .env.
#   Groq (free):      https://console.groq.com/keys
#   Gemini (free):    https://aistudio.google.com/apikey
#   OpenRouter:       https://openrouter.ai/keys  (optional: add
#                     openrouter/openrouter/free to LLM_FALLBACK_MODELS)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# How many questions each user may ask the assistant per day (default 20).
# ASSISTANT_DAILY_LIMIT=20
